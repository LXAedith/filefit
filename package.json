{
  "name": "filefit",
  "version": "1.0.0",
  "description": "Shrink, convert and clean files right in your browser. Nothing is uploaded.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "heic-to": "^1.6.7",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LXAedith/filefit.git"
  },
  "keywords": [
    "privacy",
    "image-compression",
    "heic",
    "pdf",
    "exif",
    "offline",
    "pwa",
    "browser"
  ]
}
